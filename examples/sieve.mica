// Sieve of Eratosthenes: counts the primes below n.
fn count_primes(n: int): int {
  let composite = new int[n];
  let count = 0;
  let i = 2;
  while i < n {
    if composite[i] == 0 {
      count = count + 1;
      let j = i * 2;
      while j < n {
        composite[j] = 1;
        j = j + i;
      }
    }
    i = i + 1;
  }
  return count;
}

fn main() {
  print(count_primes(100));
  print(count_primes(1000000));
}
